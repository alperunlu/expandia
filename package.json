{
  "name": "expandia",
  "version": "1.0.0",
  "description": "Expandia - Empire Clash Strategy Game",
  "private": true,
  "main": "index.js",
  "scripts": {
    "bundle": "node scripts/bundle-game.js",
    "start": "npx expo start",
    "prebuild": "npm run bundle && npx expo prebuild",
    "build:ios": "npm run bundle && npx eas build --platform ios --profile production",
    "submit:ios": "npx eas submit --platform ios --profile production",
    "build:ios:preview": "npm run bundle && npx eas build --platform ios --profile preview"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@expo/ngrok": "^4.1.3"
  },
  "dependencies": {
    "expo": "~57.0.9",
    "expo-splash-screen": "~57.0.5",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-webview": "13.16.1"
  }
}
